# ----------------------------------------------------------------------
# Clean URLs (Apache)
# ----------------------------------------------------------------------

RewriteEngine On

# Redirect .html requests to their clean (extensionless) URL
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally serve the .html file for extensionless requests
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ----------------------------------------------------------------------
# Canonical: force https + non-www
# ----------------------------------------------------------------------

RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://bleachboyscleaning.com%{REQUEST_URI} [R=301,L]

# ----------------------------------------------------------------------
# Custom error page
# ----------------------------------------------------------------------

ErrorDocument 404 /index.html

# ----------------------------------------------------------------------
# Caching
# ----------------------------------------------------------------------

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/x-icon           "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType text/html              "access plus 1 hour"
</IfModule>

# ----------------------------------------------------------------------
# Compression
# ----------------------------------------------------------------------

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain \
    application/javascript application/json image/svg+xml
</IfModule>
